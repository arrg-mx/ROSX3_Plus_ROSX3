      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://omni_description/meshes/sensor/visual/camera_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://omni_description/meshes/sensor/visual/camera_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="-0.035 0.00 0.45"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_PC_link">
  </link>
  <joint name="camera_PC_joint" type="fixed">
    <origin rpy="-1.57 0 -1.57" xyz="0.0 0.0 0.0"/>
    <parent link="camera_link"/>
    <child link="camera_PC_link"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="camera_plugin">
        <ros>
          <!--namespace>/</namespace-->
          <remapping>~/image_raw:=image_raw</remapping>
          <remapping>~/camera_info:=camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_PC_link</frame_name>
        <hack_baseline>0.2</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>
  <!-- With true, blue rays are shown in Gazebo-->
  <link name="laser_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0176558922685589 0.000671805271544437 0.0219302095894866"/>
      <mass value="0.0483909504209895"/>
      <inertia ixx="1.58456966399128E-05" ixy="-4.23913983850005E-07" ixz="-2.09597897904374E-07" iyy="3.89262522903605E-05" iyz="3.24809725932687E-07" izz="4.86230801106223E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://omni_description/meshes/sensor/visual/laser_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://omni_description/meshes/sensor/visual/laser_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.11 1.7948E-05 0.03755"/>
    <parent link="base_link"/>
    <child link="laser_link"/>
  </joint>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>1.5</max>
          <resolution>0.017453</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="laser_plugin">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="laser_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <!-- Mono - camera sensor -->
  <link name="mono_link">
    <inertial>
      <origin rpy="0 0 0" xyz="5.8458E-05 0.0095015 -0.0014824"/>
      <mass value="0.0097589"/>
      <inertia ixx="3.3488E-06" ixy="1.3667E-08" ixz="6.4235E-09" iyy="1.8662E-06" iyz="-1.0265E-07" izz="2.5696E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dofbot_description/meshes/sensor/visual/mono_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dofbot_description/meshes/sensor/visual/mono_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="mono_joint" type="fixed">
    <origin rpy="1.5708 0 0" xyz="-0.0482 -0.05145 -0.0022"/>
    <parent link="arm_link_04"/>
    <child link="mono_link"/>
  </joint>
  <link name="monocular_camera_link">
  </link>
  <joint name="base_camera_joint" type="fixed">
    <parent link="mono_link"/>
    <child link="monocular_camera_link"/>
    <origin rpy="3.14 -1.57 0" xyz="0 0 0"/>
  </joint>
  <!-- MONOCULAR CAMERA -->
  <gazebo reference="monocular_camera_link">
    <material>Gazebo/Orange</material>
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="monocular_camera_plugin">
        <ros>
          <!--namespace>/</namespace-->
          <remapping>~/image_raw:=image_raw</remapping>
          <remapping>~/camera_info:=camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>monocular_camera_link</frame_name>
        <hack_baseline>0.2</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>
  <link name="imu_link"/>
  <joint name="base_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 3.1415 1.5707" xyz="-0.06 0.01 0.01"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <joint name="omni_to_dofbot_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin rpy="0 0 -1.57" xyz="0.1025 0 0.031"/>
    <axis xyz="0 0 1"/>
    <limit effort="1" lower="0" upper="0" velocity="1"/>
  </joint>
  <link name="mastil_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.1775"/>
      <geometry>
        <box size="0.02 0.04 0.355"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.1775"/>
      <geometry>
        <box size="0.02 0.04 0.355"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_to_mastil_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.035 0 0.0615"/>
    <parent link="base_link"/>
    <child link="mastil_link"/>
  </joint>
  <link name="display_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://omni_dofbot_description/meshes/display_omni_dofbot.stl"/>
      </geometry>
      <material name="">
        <color rgba="0 0.7 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://omni_dofbot_description/meshes/display_omni_dofbot.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="display_joint" type="fixed">
    <parent link="mastil_link"/>
    <child link="display_link"/>
    <origin rpy="0 0 0" xyz="-0.07 0.0 0.265"/>
  </joint>
  <gazebo reference="arm_base_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="arm_link_01">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="arm_link_02">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="arm_link_03">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="arm_link_04">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="arm_link_05">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rgrip_finger01">
    <material>Gazebo/SkyBlue</material>
  </gazebo>
  <gazebo reference="rgrip_finger02">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="rgrip_finger03">
    <material>Gazebo/BlueTransparent</material>
  </gazebo>
  <gazebo reference="lgrip_finger01">
    <material>Gazebo/SkyBlue</material>
  </gazebo>
  <gazebo reference="lgrip_finger02">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="lgrip_finger03">
    <material>Gazebo/BlueTransparent</material>
  </gazebo>
  <gazebo reference="mono_link">
    <material>Gazebo/LightBlueLaser</material>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="front_left_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="back_left_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="back_right_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Grey</material>
  </gazebo>
  <ros2_control name="GazeboSystem_dofbot" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="arm_joint_01">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_joint_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_joint_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_joint_04">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_joint_05">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="grip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rfinger_joint_01">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rfinger_joint_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="lfinger_grip_joint_01">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="lfinger_grip_joint_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="lfinger_grip_joint_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="front_left_joint">
      <!-- M1 -->
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="front_right_joint">
      <!-- M2 -->
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="back_right_joint">
      <!-- M3 -->
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="back_left_joint">
      <!-- M4 -->
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- Omnidirectional plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="omni_controller_gz">
      <!-- 3 DOF plugin, (Vx,Vy,Wz) -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>
  <!-- Plugin para visualizar correctamente las posiciones de las juntas en RViz -->
  <gazebo>
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="joint_states_gz">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_joint</joint_name>
      <joint_name>front_right_joint</joint_name>
      <joint_name>back_right_joint</joint_name>
      <joint_name>back_left_joint</joint_name>
    </plugin>
  </gazebo>
  <!-- Plugin de control ROS 2 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/robousr/ROS2Dev/TSR/proyecto_ws/install/omni_dofbot_description/share/omni_dofbot_description/config/omni_dofbot_controller.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
